# Copy to apps/server/.env for local development. Never commit real values.

# --- apps/server: local model cascade (defaults point at a local ~/ods-style stack) ---
# Speech-to-text (OpenAI-compatible /v1/audio/transcriptions), e.g. speaches
SOTTO_STT_URL=http://127.0.0.1:9000/v1
SOTTO_STT_MODEL=Systran/faster-whisper-base
# Chat/LLM (OpenAI-compatible /v1/chat/completions), e.g. llama-server
SOTTO_LLM_URL=http://127.0.0.1:8080/v1
SOTTO_LLM_MODEL=qwen3.6-35b-a3b
# Text-to-speech (OpenAI-compatible /v1/audio/speech), e.g. Kokoro
SOTTO_TTS_URL=http://127.0.0.1:8880/v1
SOTTO_TTS_MODEL=kokoro

# Optional bearer token sent to all three of the above. Set the three URLs to
# https://api.openai.com/v1 (models whisper-1 / gpt-4o-mini / tts-1) to run the
# same cascade on OpenAI instead of local models. See docs/openai.md.
SOTTO_API_KEY=

# Server bind
SOTTO_PORT=8790
SOTTO_HOST=0.0.0.0

# --- apps/client ---
# Base URL the client uses to reach apps/server.
EXPO_PUBLIC_SERVER_URL=http://localhost:8790
# Voice provider: "local" (WebSocket to apps/server) or "fake" (scripted fixtures, no server needed)
EXPO_PUBLIC_VOICE=local
