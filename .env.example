# Copy to apps/server/.env for local development. Never commit real values.
# The server reads apps/server/.env at startup (see src/index.ts); shell
# variables already set in your environment override values from this file.

# --- apps/server: local model cascade (defaults point at a local ~/ods-style stack) ---
# Speech-to-text (OpenAI-compatible /v1/audio/transcriptions). Reference/default
# is native whisper.cpp whisper-server on 9001 (SOTTO_STT_MODEL is ignored by
# whisper.cpp — it uses whatever .bin it was started with). To use speaches
# instead (Docker, OpenAI-compatible, slower), see "Swapping STT to speaches"
# in docs/local-models.md: SOTTO_STT_URL=http://127.0.0.1:9000/v1 with a real
# faster-whisper model id.
SOTTO_STT_URL=http://127.0.0.1:9001/v1
SOTTO_STT_MODEL=Systran/faster-whisper-base
# Chat/LLM (OpenAI-compatible /v1/chat/completions), e.g. llama-server
SOTTO_LLM_URL=http://127.0.0.1:8080/v1
SOTTO_LLM_MODEL=qwen3.6-35b-a3b
# Text-to-speech (OpenAI-compatible /v1/audio/speech), e.g. Kokoro
SOTTO_TTS_URL=http://127.0.0.1:8880/v1
SOTTO_TTS_MODEL=kokoro

# Optional bearer token sent to all three of the above. Set the three URLs to
# https://api.openai.com/v1 (models whisper-1 / gpt-4o-mini / tts-1) to run the
# same cascade on OpenAI instead of local models. See docs/openai.md.
SOTTO_API_KEY=

# Server bind. Defaults to 127.0.0.1 — this server has no accounts/auth
# (docs/voice-pipeline.md "Security"), so anything reachable can drive your
# local models. Set to 0.0.0.0 only to test from a phone on the same LAN, and
# only on a trusted network.
SOTTO_PORT=8790
SOTTO_HOST=127.0.0.1

# Comma-separated allowlist of browser Origin headers allowed to talk to this
# server (native clients send no Origin and are always allowed). Any
# http://localhost:* / http://127.0.0.1:* origin is always allowed regardless
# of this value. Defaults to the Expo web dev server ports.
SOTTO_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082

# Caps concurrent voice sessions (pending + connected) across all clients.
SOTTO_MAX_SESSIONS=4

# --- apps/client ---
# Base URL the client uses to reach apps/server.
EXPO_PUBLIC_SERVER_URL=http://localhost:8790
# Voice provider: "local" (WebSocket to apps/server) or "fake" (scripted fixtures, no server needed)
EXPO_PUBLIC_VOICE=local
