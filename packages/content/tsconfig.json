{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    // The CLI runs directly under Node's native TS type-stripping (no build
    // step), which requires relative imports to use the real ".ts"
    // extension — plain Node does not do TS's usual ".js" -> ".ts" mapping.
    "allowImportingTsExtensions": true,
    // test/assemble-draft.test.ts imports scripts/assemble-draft.mjs (Lane P,
    // planning/LIBRARY-EXPANSION.md) directly to unit-test its pure
    // conversion functions — allowJs lets tsc resolve that plain-JS module.
    "allowJs": true
  },
  "include": ["src", "test"]
}
