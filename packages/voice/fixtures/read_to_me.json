      "event": { "type": "reading", "sentence": 0 }
    },
    {
      "kind": "event",
      "delayMs": 400,
      "event": { "type": "reading", "sentence": 1 }
    },
    {
      "kind": "event",
      "delayMs": 400,
      "event": { "type": "reading", "sentence": 2 }
    },
    {
      "kind": "event",
